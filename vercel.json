{
  "rewrites": [
    {
      "source": "/api/seller/:path*",
      "destination": "/api/[...route]?route=seller/:path*"
    },
    {
      "source": "/api/recruiter/:path*",
      "destination": "/api/[...route]?route=recruiter/:path*"
    },
    {
      "source": "/api/ai/:path*",
      "destination": "/api/[...route]?route=ai/:path*"
    }
  ]
}
